package Session;

import java.io.IOException;
import java.io.PrintWriter;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

@WebServlet(name = "SessionServlet", urlPatterns = {"/SessionServlet"})
public class SessionServlet extends HttpServlet {

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        PrintWriter out = response.getWriter();

        out.println("<html><body style='background-color: lightblue;'>");

        String action = request.getParameter("action");

        if ("logout".equals(action)) {
            HttpSession session = request.getSession(false);

            if (session != null) {
                session.invalidate();
            }

            out.println("<h2>Session Destroyed!You have been logged out.</h2>");
            out.println("<a href='index.html'>Start New Session</a>");
            return;
        }

        HttpSession session = request.getSession(true);

        if (session.isNew()) {
            session.setAttribute("visited", true);
            out.println("<h2>Welcome! You are visiting this page for the FIRST time.</h2>");
        } else {
            out.println("<h2>Welcome Back! You have visited this page Earlier.</h2>");
        }

        out.println("<p><b>Session ID:</b>" + session.getId() + "</p>");
        out.println("<a href='SessionServlet'>Refresh Page</a> | ");
        out.println("<a href='SessionServlet?action=logout'>Logout(Destroy Session)</a>");

        out.println("</body></html>");
    }
}


OUTPUT:
First visit: Welcome! You are visiting this page for the FIRST time.
Earlier visit: Welcome Back! You have visited this page Earlier.
Logout: Session Destroyed! You have been logged out.
