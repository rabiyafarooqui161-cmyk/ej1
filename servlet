package QuizPack;

import java.io.IOException;
import java.io.PrintWriter;
import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.Statement;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

@WebServlet(name = "QuizServlet",
            urlPatterns = {"/QuizServlet"})
public class QuizServlet extends HttpServlet {

    private Connection getConnection() throws Exception {
        Class.forName("com.mysql.jdbc.Driver");

        String url =
            "jdbc:mysql://localhost:3306/j2ee?useSSL=false";

        return DriverManager.getConnection(
            url, "root", "admin");
    }

    @Override
    protected void doGet(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        PrintWriter out = response.getWriter();

        try (Connection con = getConnection();
             Statement stmt = con.createStatement();
             ResultSet rs = stmt.executeQuery(
                 "SELECT * FROM quiz ORDER BY RAND() LIMIT 1")) {

            if (rs.next()) {
                String id = rs.getString("id");
                String qText = rs.getString("question");

                out.print("<div>");
                out.print("<h2>Quiz Application</h2>");
                out.print("<p><strong>Question:</strong> "
                    + qText + "</p>");

                out.print("<form action='QuizServlet' method='post'>");

                out.print("<input type='hidden' name='qId' value='"
                    + id + "'>");

                out.print("<input type='text' name='userAns' "
                    + "placeholder='Your answer' required><br><br>");

                out.print("<button type='submit'>Submit Answer</button>");
                out.print("</form>");
                out.print("</div>");
            }

        } catch (Exception e) {
            out.print("Database Error: " + e);
        }
    }

    @Override
    protected void doPost(HttpServletRequest request,
            HttpServletResponse response)
            throws ServletException, IOException {

        PrintWriter out = response.getWriter();

        String qId = request.getParameter("qId");
        String userAns = request.getParameter("userAns").trim();

        try (Connection con = getConnection();
             Statement stmt = con.createStatement();
             ResultSet rs = stmt.executeQuery(
                 "SELECT answer FROM quiz WHERE id =" + qId)) {

            out.print("<div>");

            if (rs.next()) {
                String correctAns = rs.getString("answer");

                if (correctAns.equals(userAns)) {
                    out.print("<h2 style='color:green;'>"
                        + "Correct Answer</h2>");
                } else {
                    out.print("<h2 style='color:red;'>"
                        + "Wrong Answer</h2>");

                    out.print("<p>The correct answer was: <strong>"
                        + correctAns + "</strong></p>");
                }
            }

            out.print("<br><a href='QuizServlet'>"
                + "<button>Next Question</button></a>");

            out.print("</div>");

        } catch (Exception e) {
            out.print("Processing Error: " + e);
        }
    }
}


