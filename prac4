====================================

AIM: Create a registration and login JSP application to register and authenticate the user based on username and password using JDBC.

DATABASE QUERY:

CREATE DATABASE j2ee;
USE j2ee;

CREATE TABLE users (
    username VARCHAR(50),
    password VARCHAR(50)
);


FILE 1: index.jsp

<%@ page import="java.sql.*" %>
<!DOCTYPE html>
<html>
<head>
    <title>Register</title>
</head>
<body>

    <h2>User Registration</h2>

    <form method="post">
        Username:
        <input type="text" name="username" required><br><br>

        Password:
        <input type="password" name="password" required><br><br>

        <input type="submit" value="Register">
    </form>

    <%
        String u = request.getParameter("username");
        String p = request.getParameter("password");

        if (u != null && p != null) {
            try {
                Class.forName("com.mysql.jdbc.Driver");

                String url =
                    "jdbc:mysql://localhost:3306/j2ee?useSSL=false";

                Connection con =
                    DriverManager.getConnection(
                        url, "root", "admin@123");

                Statement stmt = con.createStatement();

                String query =
                    "INSERT INTO users VALUES('" + u + "', '" + p + "')";

                int row = stmt.executeUpdate(query);

                if (row > 0) {
                    out.println("<p>Registration Successful!</p>");
                }

            } catch (Exception e) {
                out.println(e);
            }
        }
    %>

    <a href="login.jsp">Login here</a>

</body>
</html>


FILE 2: login.jsp

<%@ page import="java.sql.*" %>
<!DOCTYPE html>
<html>
<head>
    <title>Login</title>
</head>
<body>

    <h2>User Login</h2>

    <form method="post">
        Username:
        <input type="text" name="username" required><br><br>

        Password:
        <input type="password" name="password" required><br><br>

        <input type="submit" value="Login">
    </form>

    <%
        String u = request.getParameter("username");
        String p = request.getParameter("password");

        if (u != null && p != null) {
            try {
                Class.forName("com.mysql.jdbc.Driver");

                String url =
                    "jdbc:mysql://localhost:3306/j2ee?useSSL=false";

                Connection con =
                    DriverManager.getConnection(
                        url, "root", "admin@123");

                Statement stmt = con.createStatement();

                String query =
                    "SELECT * FROM users WHERE username='" + u +
                    "' AND password='" + p + "'";

                ResultSet rs = stmt.executeQuery(query);

                if (rs.next()) {
                    session.setAttribute("user", u);
                    out.println("<p>Login Success!</p>");
                } else {
                    out.println("<p>Invalid Username or Password!</p>");
                }

            } catch (Exception e) {
                out.println(e);
            }
        }
    %>

    <a href="index.jsp">Register here</a>

</body>
</html>
