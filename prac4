PRACTICAL 4B
====================================

AIM: Develop a simple JSP application to pass values from one page to another with validations. (Name-txt, age-txt, hobbies-checkbox, email-txt, gender-radio button).

FILE 1: index.jsp

<!DOCTYPE html>
<html>
<head>
    <title>User Registration Form</title>
</head>
<body>

    <form action="process.jsp">
        Name: <input type="text" name="name"><br><br>

        Age: <input type="text" name="age"><br><br>

        Email: <input type="text" name="email"><br><br>

        Gender:
        <input type="radio" name="gender" value="Male"> Male
        <input type="radio" name="gender" value="Female"> Female
        <br><br>

        Hobbies:
        <input type="checkbox" name="hobbies" value="Coding"> Coding
        <input type="checkbox" name="hobbies" value="Reading"> Reading
        <br><br>

        <input type="submit">
    </form>

</body>
</html>


FILE 2: process.jsp

<%@page contentType="text/html" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<body>

    <%
        // Get the values from the form
        String name = request.getParameter("name");
        String age = request.getParameter("age");
        String email = request.getParameter("email");
        String gender = request.getParameter("gender");
        String[] hobbies = request.getParameterValues("hobbies");

        // Validation Check
        if (name.isEmpty() || age.isEmpty() ||
            email.isEmpty() || gender == null || hobbies == null) {

            out.print("<h3 style='color:red;'>Error: Please fill all fields!</h3>");

        } else {

            // Display data if everything is filled
            out.print("<h3>Submitted Data:</h3>");
            out.print("Name: " + name + "<br>");
            out.print("Age: " + age + "<br>");
            out.print("Email: " + email + "<br>");
            out.print("Gender: " + gender + "<br>");
            out.print("Hobbies: " + String.join(",", hobbies));
        }
    %>

    <br><br>
    <a href="index.jsp">Back to Form</a>

</body>
</html>


